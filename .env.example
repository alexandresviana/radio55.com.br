# Credenciais de acesso ao site
AUTH_USERNAME=admin
AUTH_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão (gere uma string aleatória longa)
AUTH_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Cookie Secure: auto (via X-Forwarded-Proto), ou force true/false
# COOKIE_SECURE=false

# PostgreSQL — índice e busca de gravações MP3
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Uma vez no boot: apaga arquivos gravados, transcrições de rádio, YouTube, Instagram e X monitorados.
# Mantém emissoras, palavras-chave e Auth. Remova após o deploy.
# RESET_DATABASE=true

# Diretório de dados dentro do container (padrão: /app/data)
#
# Bunny Magic Containers — volume persistente (obrigatório para gravação/transcrição):
#   Mount path: /app/data
#   Conteúdo esperado:
#     /app/data/emissoras.json      — cadastro de rádios (editável pelo admin)
#     /app/data/gravacoes/          — MP3 em gravação (antes do upload ao Bunny Storage)
#     /app/data/trechos/            — cache de clipes de detecção (~25 s cada)
#     /app/data/whisper-cache/      — modelo faster-whisper (copiado do boot da imagem)
#
# Se montou o volume em outro path, defina DATA_DIR com o mesmo valor do Mount path.
# DATA_DIR=/app/data
#
# MP3 finalizados vão para Bunny Storage (BUNNY_STORAGE_*). Trechos ficam só no volume;
# se o pod reiniciar sem volume, o app regenera trechos a partir do MP3 no storage.

# Transcrição automática (faster-whisper — modelo embutido na imagem, copiado para o volume no boot)
# WHISPER_ENABLED=true
# WHISPER_MODEL=base
# WHISPER_CACHE_DIR=/app/data/whisper-cache
# WHISPER_CPU_THREADS=1  (threads do único worker persistente; também trava OpenMP/BLAS)
# HF_TOKEN=hf_...  (opcional — aumenta limite de download no Hugging Face)
# Não use /opt/whisper-models — remova essa env no Bunny se ainda existir

# Monitoramento de canais do YouTube (legendas via youtube-transcript-plus)
# YOUTUBE_ENABLED=true
# Máximo de vídeos recentes por canal na fila (padrão 30)
# YOUTUBE_VIDEOS_POR_CANAL=30

# Monitoramento do Instagram (mesmo APIFY_TOKEN para os 3 actors):
#   - apify/instagram-scraper          → publicações de perfis
#   - apify/instagram-hashtag-scraper  → publicações por termo/hashtag
#   - apify/instagram-comment-scraper  → comentários das publicações coletadas
# Cobrado por item retornado (~US$ 2,30/1.000 no plano Starter).
# Defaults = pacote econômico (intervalo 120 min, poucos itens, comentários off).
# Token da conta Apify (Settings → API & Integrations):
# APIFY_TOKEN=apify_api_...
# INSTAGRAM_ENABLED=true
# Intervalo entre coletas em minutos (padrão 120; mínimo 5)
# INSTAGRAM_SYNC_MINUTOS=120
# Máximo de publicações por fonte (perfil ou termo/hashtag) em cada coleta (padrão 5, máx 50)
# INSTAGRAM_POSTS_POR_PERFIL=5
# Comentários: opt-in (só liga com "true"). Caro — deixe off se o budget estiver apertado.
# INSTAGRAM_COMENTARIOS_ENABLED=false
# Máximo de comentários por publicação em cada coleta (padrão 10, máx 100)
# INSTAGRAM_COMENTARIOS_POR_POST=10
# Intervalo do ciclo de comentários em minutos (padrão 180, mínimo 5; lote de 3 posts)
# INSTAGRAM_COMENTARIOS_INTERVALO_MINUTOS=180

# Monitoramento do X (mesmo APIFY_TOKEN):
#   - apidojo/twitter-scraper-lite → posts por termo/frase de busca
# X_ENABLED=true
# Intervalo entre coletas em minutos (padrão 120; mínimo 5)
# X_SYNC_MINUTOS=120
# Máximo de posts por ciclo de sync (padrão 15, máx 200)
# X_TWEETS_POR_CICLO=15

# Biblioteca de Anúncios Meta/Facebook (mesmo APIFY_TOKEN):
#   - apify/facebook-ads-scraper → anúncios por termo ou página
# META_ADS_ENABLED=true
# META_ADS_SYNC_MINUTOS=120
# META_ADS_POR_CICLO=15
# País da biblioteca (ISO-2; padrão BR)
# META_ADS_PAIS=BR

# Backup de MP3 para Bunny Storage (https://docs.bunny.net/api-reference/storage)
# Use a senha da Storage Zone (FTP & API Access), não a API key da conta
# BUNNY_STORAGE_ZONE=radio55-gravacoes
# BUNNY_STORAGE_ACCESS_KEY=sua-storage-zone-password
# BUNNY_STORAGE_REGION=br
# BUNNY_STORAGE_PATH_PREFIX=radio55/gravacoes
# BUNNY_STORAGE_INTERVAL_MS=300000
# URL pública do Pull Zone (opcional — redireciona reprodução para o CDN)
# BUNNY_STORAGE_CDN_BASE=https://sua-zona.b-cdn.net/radio55/gravacoes
# MP3 local some do disco após 1h (e assim que o Bunny confirma o envio).
# Transcrições e busca no MP3 continuam (reprodução via storage).
# RECORDING_RETENTION_MS=3600000

# Rotação de arquivos MP3 (padrão: 1 hora). Fecha o MP3 com segurança e abre outro.
# RECORDING_ROTATE_MS=3600000

# IA: briefing da home + busca na página inicial
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_BUSCA_LIMITE=20

# Docker Compose (opcional — sobrescreve valores acima)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=sua_senha_forte
# AUTH_SECRET=segredo_longo_aleatorio
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
